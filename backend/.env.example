# AssemblyAI API Configuration
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_MODEL=universal-3.5-pro  # or universal-3.6-preview

# LLM Providers (Pick at least one: Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Search API (for ground-truth fact checking)
# TAVILY_API_KEY=your_tavily_api_key_here
# If TAVILY_API_KEY is empty, fallback duckduckgo search will be used automatically.

# Text-to-Speech Interruption Engine
TTS_PROVIDER=edge-tts  # options: edge-tts (free/local), openai, cartesia, elevenlabs
TTS_VOICE_AR=ar-EG-SalmaNeural
TTS_VOICE_EN=en-US-JennyNeural

# Database
DATABASE_URL=sqlite+aiosqlite:///./call_intelligence.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/call_intel

# App Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
