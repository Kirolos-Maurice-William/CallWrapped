# ===================================================
# Voice Arbitrator - Environment Variables
# AssemblyAI Voice Agent Hackathon (lablab.ai)
# ===================================================

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
COMMAND_PREFIX="!"

# AssemblyAI API Configuration
ASSEMBLYAI_API_KEY="your_assemblyai_api_key_here"
ASSEMBLYAI_MODEL="universal-3-5-pro"
SPEECH_LANGUAGE="ar"

# Groq LPU (Ultra-fast LLM inference)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Tavily Search API (Authoritative ground-truth verification)
TAVILY_API_KEY="your_tavily_api_key_here"

# Live Dashboard / Backend Integration URL
BACKEND_API_URL="http://127.0.0.1:8000"

# Database Connection (SQLite local, PostgreSQL for cloud)
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"

# Voice VAD & Audio Parameters
SILENCE_DURATION_SEC=1.5
SILENCE_THRESHOLD_RMS=80
MIN_SPEECH_DURATION_SEC=0.5
MAX_SPEECH_DURATION_SEC=15.0

# Neural Voice Settings (Edge-TTS)
TTS_VOICE_AR="ar-EG-ShakirNeural"
TTS_RATE="-3%"
TTS_PITCH="+0Hz"
