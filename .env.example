# ===================================================
# Voice Arbitrator - Environment Variables Template
# AssemblyAI Voice Agent Hackathon
# ===================================================

# ---------------------------------------------------
# 1. Discord Bot Configuration
# ---------------------------------------------------
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
COMMAND_PREFIX="!"

# ---------------------------------------------------
# 2. AssemblyAI Speech-to-Text Configuration
# ---------------------------------------------------
ASSEMBLYAI_API_KEY="your_assemblyai_api_key_here"
PRIMARY_STT_PROVIDER="assemblyai"
SPEECH_LANGUAGE="ar"

# Speech Model Selection:
# You can specify a single model or a comma-separated fallback list.
# Available models: universal-3-6-pro, universal-3-5-pro, universal-2
SPEECH_MODELS="universal-3-6-pro,universal-3-5-pro,universal-2"
ASSEMBLYAI_MODEL="universal-3-6-pro"

# Polling configuration for async transcription
ASSEMBLYAI_POLL_ATTEMPTS=40
ASSEMBLYAI_POLL_INTERVAL_SEC=0.5

# ---------------------------------------------------
# 3. Groq LPU Epistemic Engine & Multi-Key Rotation
# ---------------------------------------------------
# Primary Groq API Key (required)
GROQ_API_KEY="your_primary_groq_api_key_here"

# Secondary Groq API Key (optional - enables multi-key pool rotation to double token budget)
GROQ_API_KEY_2=""

# Groq Model Selection
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_INSTANT_MODEL="qwen/qwen3.8-27b"
GROQ_BATCH_MODEL="qwen/qwen3.8-27b"

# Batched Analytics Window (in seconds)
ANALYTICS_ENABLED=1
ANALYTICS_WINDOW_SEC=75

# ---------------------------------------------------
# 4. Tavily Search API (Ground-Truth Evidence Verification)
# ---------------------------------------------------
TAVILY_API_KEY="your_tavily_api_key_here"

# ---------------------------------------------------
# 5. Live Dashboard & Backend Integration
# ---------------------------------------------------
BACKEND_API_URL="http://127.0.0.1:8000"
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
PORT=8000
HOST="127.0.0.1"

# ---------------------------------------------------
# 6. Audio VAD (Voice Activity Detection) Parameters
# ---------------------------------------------------
SILENCE_DURATION_SEC=1.5
SILENCE_THRESHOLD_RMS=80
MIN_SPEECH_DURATION_SEC=0.5
MAX_SPEECH_DURATION_SEC=15.0

# ---------------------------------------------------
# 7. Natural Neural TTS Voice (Edge-TTS)
# ---------------------------------------------------
TTS_PROVIDER="edge-tts"
TTS_VOICE_AR="ar-EG-ShakirNeural"
TTS_VOICE_EN="en-US-JennyNeural"
TTS_RATE="-3%"
TTS_PITCH="+0Hz"

# ---------------------------------------------------
# 8. Discord Embed Styling Colors (Hex)
# ---------------------------------------------------
EMBED_COLOR_INFO=0x5865F2
EMBED_COLOR_DISPUTE=0xED4245
EMBED_COLOR_VERDICT=0x57F287
EMBED_COLOR_ECHO=0xFEE75C
