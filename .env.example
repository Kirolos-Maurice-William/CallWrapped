# ===================================================
# CallWrapped - Environment Variables Template
# AssemblyAI Voice Agent Hackathon
# ===================================================

# ---------------------------------------------------
# 1. Discord Bot Configuration
# ---------------------------------------------------
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="1550926707517558864"
DISCORD_INVITE_PERMISSIONS="36718592"
COMMAND_PREFIX="!"

# ---------------------------------------------------
# 2. AssemblyAI Speech-to-Text Configuration
# ---------------------------------------------------
ASSEMBLYAI_API_KEY="your_assemblyai_api_key_here"
SPEECH_LANGUAGE="ar"

# Speech Model Selection:
# You can specify a single model or a comma-separated fallback list.
# Available models: universal-3-5-pro, universal-2
SPEECH_MODELS="universal-3-5-pro,universal-2"
ASSEMBLYAI_MODEL="universal-3-5-pro"

# Polling configuration for async transcription
ASSEMBLYAI_POLL_ATTEMPTS=40
ASSEMBLYAI_POLL_INTERVAL_SEC=0.5

# ---------------------------------------------------
# 3. Groq LPU Epistemic Engine & Multi-Key Rotation
# ---------------------------------------------------
# Primary Groq API Key (required)
GROQ_API_KEY="your_primary_groq_api_key_here"

# Secondary Groq API Key (optional - enables multi-key pool rotation to double token budget)
GROQ_API_KEY_2=""

# Groq Model Selection
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_INSTANT_MODEL="qwen/qwen3.8-27b"
GROQ_BATCH_MODEL="qwen/qwen3.8-27b"

# Batched Analytics Window (in seconds)
ANALYTICS_ENABLED=1
ANALYTICS_WINDOW_SEC=75

# ---------------------------------------------------
# 4. Tavily Search API (Ground-Truth Evidence Verification)
# ---------------------------------------------------
TAVILY_API_KEY="your_tavily_api_key_here"

# ---------------------------------------------------
# 5. Two-Stage Referee Settings
# ---------------------------------------------------
DISPUTE_OFFER_COOLDOWN_SEC=180.0
DISPUTE_OFFER_EXPIRY_SEC=30.0

# ---------------------------------------------------
# 6. Test-Mode Capture Flag (Dataset collection)
# ---------------------------------------------------
# Default: 0 (Disabled). Strictly in-memory voice processing by default.
# When enabled (1), or dynamically toggled via Discord admin command `!start-capture`,
# finalized utterances are saved to an isolated timestamped session directory:
# `recordings/test_session/<YYYY-MM-DD_HHMM>/`
# Each session contains:
#   - utterance_*.wav (16kHz mono audio)
#   - session_log.jsonl (per-session metadata & latency telemetry)
#   - labels_DRAFT.csv (generated on `!stop-capture` with human annotation columns)
TEST_CAPTURE_MODE=0

# ---------------------------------------------------
# 7. Live Dashboard & Backend Integration
# ---------------------------------------------------
BACKEND_API_URL="http://127.0.0.1:8000"
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ---------------------------------------------------
# 8. Audio VAD (Voice Activity Detection) Parameters
# ---------------------------------------------------
SILENCE_DURATION_SEC=1.5
SILENCE_THRESHOLD_RMS=80
MIN_SPEECH_DURATION_SEC=0.5
MAX_SPEECH_DURATION_SEC=15.0

# ---------------------------------------------------
# 9. Natural Neural TTS Voice (Edge-TTS)
# ---------------------------------------------------
TTS_VOICE_AR="ar-EG-ShakirNeural"
TTS_RATE="-3%"
TTS_PITCH="+0Hz"
TTS_TIMEOUT_SEC=2.5

# ---------------------------------------------------
# 10. Discord Embed Styling Colors (Hex)
# ---------------------------------------------------
EMBED_COLOR_INFO=0x5865F2
EMBED_COLOR_VERDICT=0x57F287
